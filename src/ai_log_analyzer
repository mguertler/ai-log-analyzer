BACKENDS = ("openai", "ollama")
OPENAI_API_STYLES = ("chat_completions", "responses")


def resolve_backend(config: Dict[str, Any], args: argparse.Namespace) -> None:
    """Fill CLI gaps from the selected backend section; the other section is ignored entirely.

    argparse validates choices only for values given on the command line, so values that
    come from the config file are checked here.
    """
    if args.api not in BACKENDS:
        raise AnalyzerError(f"ai.api must be one of {', '.join(BACKENDS)}; got {args.api!r}.")
    backend = config[args.api]
    if args.api_url is None:
        args.api_url = str(backend.get("api_url", ""))
    if args.api_path is None:
        args.api_path = str(backend.get("api_path", ""))
    if args.model is None:
        args.model = str(backend.get("model", ""))
    if args.api == "ollama":
        if args.api_style is not None:
            print("Note: --api-style only affects --api openai; ignored for the ollama backend.", file=sys.stderr)
        args.api_style = "ollama"  # Internal payload style used by call_ai and the hints.
        if args.num_ctx is None:
            args.num_ctx = int(config["ollama"].get("num_ctx", 0) or 0)
    else:
        if args.api_style is None:
            args.api_style = str(config["openai"].get("api_style", "chat_completions"))
        if args.api_style not in OPENAI_API_STYLES:
            raise AnalyzerError(
                f"openai.api_style must be one of {', '.join(OPENAI_API_STYLES)}; got {args.api_style!r}. "
                "For Ollama's native API set ai.api = ollama instead."
            )
        if args.think is not None or args.num_ctx is not None:
            print("Note: --think/--no-think and --num-ctx only affect --api ollama; ignored for the openai backend.", file=sys.stderr)
        args.num_ctx = 0


def normalize_api_url(api_url: str, api_path: str) -> str:
    """Return the full API endpoint from a base URL and endpoint path.

    `api_url` is intentionally treated as a base URL for user clarity. For
    backward compatibility, a full legacy endpoint such as
    https://api.openai.com/v1/chat/completions is accepted unchanged when
    api_path is empty.
    """
    url = str(api_url or "").strip().rstrip("/")
    path = str(api_path or "").strip()
    if not url:
        raise AnalyzerError("The API base URL must not be empty (--api-url, openai.api_url or ollama.api_url).")
    # Backward compatibility for older configs where api_url contained the full endpoint.
    if re.search(r"/v\d+/(responses|chat/completions)$|/api/chat$", url):
        return url
    if not path:
        return url
    if not path.startswith("/"):
        path = "/" + path
    return url + path




STYLE_DEFAULT_PATHS = {
    "chat_completions": "/v1/chat/completions",
    "responses": "/v1/responses",
}


def effective_api_path(api_style: str, api_path: str) -> str:
    """The configured path wins; the stock chat-completions path follows the selected style."""
    path = str(api_path or "").strip()
    if not path or path == DEFAULT_CONFIG["openai"]["api_path"]:
        return STYLE_DEFAULT_PATHS.get(api_style, path)
    return path


def resolve_endpoint(args: argparse.Namespace) -> str:
    return normalize_api_url(args.api_url, effective_api_path(args.api_style, args.api_path))


def endpoint_is_local(endpoint_url: str) -> bool:
    try:
        parsed = urllib.parse.urlparse(endpoint_url)
        host = (parsed.hostname or "").strip().lower()
        if host in {"localhost", "ip6-localhost"}:
            return True
        if not host:
            return False
        try:
            return ipaddress.ip_address(host).is_loopback
        except ValueError:
            return False
    except Exception:
        return False


def format_endpoint_status(endpoint_url: str, api: str = "", model: str = "") -> str:
    detail = f" (backend: {api}, model: {model})" if api else ""
    if endpoint_is_local(endpoint_url):
        return f"Endpoint appears to be local: {endpoint_url}{detail}"
    return f"Analyzing with endpoint: {endpoint_url}{detail}"


def describe_endpoint(args: argparse.Namespace) -> str:
    """One line that answers "where is this going": endpoint, backend (ai.api) and model."""
    return format_endpoint_status(resolve_endpoint(args), str(getattr(args, "api", "")), str(getattr(args, "model", "")))

def getenv_or_config(config: Dict[str, Any], section: str, key: str, env_name: str = "") -> str:
    if env_name:
        env_value = os.environ.get(env_name, "")
        if env_value:
            return env_value
    value = config.get(section, {}).get(key, "")
    return str(value) if value is not None else ""


def ascii_text(text: str) -> str:
    return text.encode("ascii", "replace").decode("ascii")


def split_config_list(value: Any) -> List[str]:
    """Parse empty, comma-separated, repeated-key, or heredoc config values."""
    if value is None:
        return []
    if isinstance(value, list):
        items: List[str] = []
        for item in value:
            items.extend(split_config_list(item))
        return items
    text = str(value).strip()
    if not text:
        return []
    items = []
    for line in text.splitlines():
        line = line.strip()
        if not line:
            continue
        # Comma-separated values are intended for simple patterns/topics.
        # Regexes containing commas should be configured via heredoc, one per line.
        items.extend(part.strip() for part in line.split(",") if part.strip())
    return items



def should_exclude(line: str, keyword_patterns: Sequence[str], regex_patterns: Sequence[str]) -> bool:
    lowered = line.lower()
    for keyword in keyword_patterns:
        keyword = str(keyword).strip()
        if keyword and keyword.lower() in lowered:
            return True
    for pattern in regex_patterns:
        pattern = str(pattern).strip()
        if not pattern:
            continue
        try:
            if re.search(pattern, line):
                return True
        except re.error as exc:
            raise AnalyzerError(f"Invalid regex in logs.exclude_regex_patterns: {pattern!r}: {exc}") from exc
    return False


def write_filtered_lines_to_temp(
    line_iter: Iterable[str],
    keyword_patterns: Sequence[str],
    regex_patterns: Sequence[str],
    tail_lines: int = 0,
) -> Tuple[Path, int]:
    """Write filtered lines from any text iterator to a temp file.

    When tail_lines > 0, only the last N filtered lines are kept. This is
    intentionally implemented after filtering so --tail-lines describes the
    analyzed input size.
    """
    if tail_lines < 0:
        raise AnalyzerError("--tail-lines must be greater than or equal to zero.")
    temp = tempfile.NamedTemporaryFile("w", encoding="utf-8", delete=False, prefix="ai-log-", suffix=".log")
    temp_path = Path(temp.name)
    count = 0
    try:
        with temp:
            if tail_lines > 0:
                kept = deque(maxlen=tail_lines)
                for raw_line in line_iter:
                    if should_exclude(raw_line, keyword_patterns, regex_patterns):
                        continue
                    kept.append(raw_line)
                for raw_line in kept:
                    temp.write(raw_line if raw_line.endswith("\n") else raw_line + "\n")
                count = len(kept)
            else:
                for raw_line in line_iter:
                    if should_exclude(raw_line, keyword_patterns, regex_patterns):
                        continue
                    temp.write(raw_line if raw_line.endswith("\n") else raw_line + "\n")
                    count += 1
    except Exception:
        try:
            temp_path.unlink(missing_ok=True)
        finally:
            raise
    return temp_path, count


def iter_input_files(paths: Sequence[str]) -> Iterator[str]:
    for input_file in paths:
        try:
            with open(input_file, "r", encoding="utf-8", errors="replace") as src:
                for raw_line in src:
                    yield raw_line
        except PermissionError as exc:
            raise AnalyzerError(
                f"Permission denied while reading input file: {input_file}. Run with suitable permissions or choose another file."
            ) from exc
        except FileNotFoundError as exc:
            raise AnalyzerError(f"Input file not found: {input_file}") from exc


def collect_from_input_files(
    input_files: Sequence[str],
    keyword_patterns: Sequence[str],
    regex_patterns: Sequence[str],
    tail_lines: int = 0,
) -> Tuple[Path, int]:
    return write_filtered_lines_to_temp(iter_input_files(input_files), keyword_patterns, regex_patterns, tail_lines)


def collect_from_stdin(
    keyword_patterns: Sequence[str],
    regex_patterns: Sequence[str],
    tail_lines: int = 0,
) -> Tuple[Path, int]:
    return write_filtered_lines_to_temp(sys.stdin, keyword_patterns, regex_patterns, tail_lines)


# Backward compatibility for older test invocations.
def collect_from_input_file(input_file: str, keyword_patterns: Sequence[str], regex_patterns: Sequence[str]) -> Tuple[Path, int]:
    return collect_from_input_files([input_file], keyword_patterns, regex_patterns, 0)



def iter_chunks(path: Path, chunk_size: int) -> Iterator[List[str]]:
    if chunk_size <= 0:
        raise AnalyzerError("--chunk-size must be greater than zero.")
    with path.open("r", encoding="utf-8", errors="replace") as handle:
        chunk: List[str] = []
        for line in handle:
            chunk.append(line.rstrip("\n"))
            if len(chunk) >= chunk_size:
                yield chunk
                chunk = []
        if chunk:
            yield chunk


def print_input_file(path: Path) -> None:
    with path.open("r", encoding="utf-8", errors="replace") as handle:
        for line in handle:
            print(line, end="")


def progress_bar(current: int, total: int, width: int = 36) -> str:
    if total <= 0:
        return "[" + "." * width + "] 0%"
    ratio = min(max(current / total, 0.0), 1.0)
    filled = int(round(width * ratio))
    return f"[{'#' * filled}{'.' * (width - filled)}] {ratio * 100:5.1f}% ({current}/{total})"


def format_duration(seconds: float) -> str:
    seconds = max(0, int(round(seconds)))
    hours, rem = divmod(seconds, 3600)
    minutes, secs = divmod(rem, 60)
    if hours:
        return f"{hours:d}:{minutes:02d}:{secs:02d}"
    return f"{minutes:02d}:{secs:02d}"


def write_progress(current: int, total: int, enabled: bool, eta_seconds: Optional[float] = None) -> None:
    if not enabled:
        return
    line = progress_bar(current, total)
    if eta_seconds is not None and current > 0 and current < total:
        line += f" [estimated time left: {format_duration(eta_seconds)}]"
    elif eta_seconds is not None and current >= total:
        line += " [estimated time left: 00:00]"
    sys.stderr.write("\r" + line)
    sys.stderr.flush()
    if current >= total:
        sys.stderr.write("\n")
        sys.stderr.flush()


def build_chat_payload(config: Dict[str, Any], model: str, system_prompt: str, user_prompt: str) -> Dict[str, Any]:
    ai_cfg = config["ai"]
    payload: Dict[str, Any] = {
        "model": model,
        "messages": [
            {"role": "system", "content": system_prompt},
            {"role": "user", "content": user_prompt},
        ],
    }
    if ai_cfg.get("temperature") is not None:
        payload["temperature"] = ai_cfg.get("temperature")
    max_output_tokens = ai_cfg.get("max_output_tokens")
    if max_output_tokens is not None:
        payload[str(config["openai"].get("max_tokens_field", "max_tokens"))] = int(max_output_tokens)
    return payload


def build_responses_payload(config: Dict[str, Any], model: str, system_prompt: str, user_prompt: str) -> Dict[str, Any]:
    ai_cfg = config["ai"]
    payload: Dict[str, Any] = {
        "model": model,
        "instructions": system_prompt,
        "input": user_prompt,
    }
    if ai_cfg.get("temperature") is not None:
        payload["temperature"] = ai_cfg.get("temperature")
    max_output_tokens = ai_cfg.get("max_output_tokens")
    if max_output_tokens is not None:
        payload["max_output_tokens"] = int(max_output_tokens)
    return payload


def ollama_think_setting(config: Dict[str, Any]) -> Optional[bool]:
    """Config value may arrive as bool (true/false) or as text; empty means model default."""
    raw = config.get("ollama", {}).get("think", "")
    if isinstance(raw, bool):
        return raw
    text = str(raw or "").strip()
    return parse_bool(text) if text else None


def build_ollama_payload(config: Dict[str, Any], args: argparse.Namespace, model: str, system_prompt: str, user_prompt: str) -> Dict[str, Any]:
    ai_cfg = config["ai"]
    ollama_cfg = config.get("ollama", {})
    options: Dict[str, Any] = {}
    if ai_cfg.get("temperature") is not None:
        options["temperature"] = ai_cfg.get("temperature")
    max_output_tokens = ai_cfg.get("max_output_tokens")
    if max_output_tokens is not None:
        options["num_predict"] = int(max_output_tokens)
    num_ctx = int(getattr(args, "num_ctx", None) or ollama_cfg.get("num_ctx", 0) or 0)
    if num_ctx > 0:
        options["num_ctx"] = num_ctx
    payload: Dict[str, Any] = {
        "model": model,
        "messages": [
            {"role": "system", "content": system_prompt},
            {"role": "user", "content": user_prompt},
        ],
        "stream": False,  # Ollama streams NDJSON by default; one JSON document is what call_ai expects.
        "options": options,
    }
    think = getattr(args, "think", None)
    if think is None:
        think = ollama_think_setting(config)
    if think is not None and not getattr(args, "_ollama_think_unsupported", False):
        payload["think"] = think
    keep_alive = ollama_cfg.get("keep_alive", "")
    if isinstance(keep_alive, (int, float)) and not isinstance(keep_alive, bool):
        payload["keep_alive"] = keep_alive
    elif str(keep_alive or "").strip():
        payload["keep_alive"] = str(keep_alive).strip()
    return payload


TRUNCATED_FINISH_REASONS = {"length", "max_tokens", "max_output_tokens"}


def extract_response(data: Dict[str, Any], api_style: str) -> Tuple[str, str, Dict[str, int]]:
    """Return (text, finish_reason, usage) for the configured API style.

    finish_reason is normalized to the provider's own vocabulary ("stop", "length", ...) and is
    empty when the provider did not report one. usage maps prompt/output token counts if known.
    """
    if api_style == "ollama":
        usage = {}
        for source, target in (("prompt_eval_count", "prompt"), ("eval_count", "output")):
            if isinstance(data.get(source), int):
                usage[target] = data[source]
        finish_reason = str(data.get("done_reason") or "")
        message = data.get("message") or {}
        if isinstance(message, dict) and isinstance(message.get("content"), str):
            return message["content"], finish_reason, usage
        if isinstance(data.get("response"), str):  # /api/generate shape
            return data["response"], finish_reason, usage
        if isinstance(data.get("error"), str):
            raise AnalyzerError(f"Ollama error: {data['error']}")
        raise AnalyzerError("Could not extract text from Ollama response.")
    text = extract_response_text(data, api_style)
    usage_block = data.get("usage") if isinstance(data.get("usage"), dict) else {}
    usage = {}
    for keys, target in ((("prompt_tokens", "input_tokens"), "prompt"), (("completion_tokens", "output_tokens"), "output")):
        for key in keys:
            if isinstance(usage_block.get(key), int):
                usage[target] = usage_block[key]
                break
    if api_style == "responses":
        finish_reason = ""
        if data.get("status") == "incomplete":
            details = data.get("incomplete_details") or {}
            finish_reason = str(details.get("reason") or "incomplete")
        return text, finish_reason, usage
    choices = data.get("choices") or []
    finish_reason = str((choices[0] or {}).get("finish_reason") or "") if choices else ""
    return text, finish_reason, usage


def extract_response_text(data: Dict[str, Any], api_style: str) -> str:
    if api_style == "responses":
        if isinstance(data.get("output_text"), str):
            return data["output_text"]
        parts: List[str] = []
        for item in data.get("output", []) or []:
            for content in item.get("content", []) or []:
                if isinstance(content.get("text"), str):
                    parts.append(content["text"])
                elif isinstance(content.get("text"), dict) and isinstance(content["text"].get("value"), str):
                    parts.append(content["text"]["value"])
        if parts:
            return "\n".join(parts)
    choices = data.get("choices", [])
    if choices:
        first = choices[0]
        message = first.get("message", {})
        content = message.get("content")
        if isinstance(content, str):
            return content
        if isinstance(content, list):
            parts = []
            for item in content:
                if isinstance(item, dict):
                    if isinstance(item.get("text"), str):
                        parts.append(item["text"])
                    elif isinstance(item.get("content"), str):
                        parts.append(item["content"])
            if parts:
                return "\n".join(parts)
        if isinstance(first.get("text"), str):
            return first["text"]
    raise AnalyzerError("Could not extract text from API response.")


RETRYABLE_HTTP_STATUSES = {408, 409, 425, 429, 500, 502, 503, 504}
MAX_RETRY_AFTER_SECONDS = 60.0


def parse_retry_after(value: Optional[str]) -> Optional[float]:
    """Return the delay requested by a Retry-After header, capped, or None if absent/unusable."""
    if not value:
        return None
    text = str(value).strip()
    if re.fullmatch(r"\d+", text):
        return min(float(text), MAX_RETRY_AFTER_SECONDS)
    try:
        from email.utils import parsedate_to_datetime

        when = parsedate_to_datetime(text)
    except (TypeError, ValueError, IndexError):
        return None
    if when.tzinfo is None:
        when = when.replace(tzinfo=_dt.timezone.utc)
    delay = (when - _dt.datetime.now(_dt.timezone.utc)).total_seconds()
    return min(max(delay, 0.0), MAX_RETRY_AFTER_SECONDS)



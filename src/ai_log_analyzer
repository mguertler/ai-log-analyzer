def default_config_path() -> Path:
    if _platform_user_config_dir is not None:
        return Path(_platform_user_config_dir(APP_NAME)) / CONFIG_BASENAME
    xdg_config_home = os.environ.get("XDG_CONFIG_HOME")
    if xdg_config_home:
        return Path(xdg_config_home) / APP_NAME / CONFIG_BASENAME
    return Path.home() / ".config" / APP_NAME / CONFIG_BASENAME


def resolve_config_path(cli_config: Optional[str]) -> Path:
    if cli_config:
        return Path(cli_config).expanduser()
    env_config = os.environ.get(CONFIG_ENV_VAR, "").strip()
    if env_config:
        return Path(env_config).expanduser()
    if SYSTEM_CONFIG_PATH.exists():
        return SYSTEM_CONFIG_PATH
    if LEGACY_SYSTEM_CONFIG_PATH.exists():
        return LEGACY_SYSTEM_CONFIG_PATH
    return default_config_path()


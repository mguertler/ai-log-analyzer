# ai-log-analyzer.conf
# Format: key = value
# Comments: Lines starting with # are ignored. Inline comments are allowed after whitespace.
# Strings: Quotes are optional unless the value is empty or starts/ends with whitespace.
# Multi-line values: key <<EOF ... EOF

# Basic Parameters

# Function: AI backend to use. openai talks to any OpenAI-compatible endpoint (OpenAI, LiteLLM, Ollama's /v1 API)
# and uses the openai.* settings. ollama talks to Ollama's native /api/chat API and uses the ollama.* settings.
# Syntax: openai or ollama. The settings of the other backend are ignored. CLI alternative: --api openai|ollama
ai.api = openai

# Function: Maximum output tokens for each AI response (both backends).
# Syntax: integer token limit. 8192 is a practical default; use more for thinking models, whose thinking shares this budget.
ai.max_output_tokens = 8192

# OpenAI-compatible backend (ai.api = openai)

# Function: API key for OpenAI or an OpenAI-compatible server.
# Syntax: string. Empty means: read OPENAI_API_KEY from the environment if set.
openai.api_key = ""

# Function: API base URL only, without /v1/... endpoint path.
# Syntax: URL, for example https://api.openai.com, http://127.0.0.1:4000, or http://127.0.0.1:11434
openai.api_url = https://api.openai.com

# Function: Model name passed to the API.
# Syntax: OpenAI model name or local/proxy alias, for example gpt-5-mini, Gemma4-26b, or local.
openai.model = gpt-5-mini

# Native Ollama backend (ai.api = ollama)

# Function: Ollama server base URL.
# Syntax: URL, for example http://127.0.0.1:11434 or http://gpu-host:11434
ollama.api_url = http://127.0.0.1:11434

# Function: Ollama model tag as shown by "ollama list".
# Syntax: model tag, for example gemma4:26b or qwen3.8:27b
ollama.model = gemma4:26b

# Function: Context window (num_ctx) requested for every call, so no custom Modelfile is needed for large contexts.
# Syntax: integer tokens, for example 32768 or 65536. 0 keeps the model default. CLI alternative: --num-ctx N
# Ollama reloads the model when this changes. Keep chunk size and this value consistent: a 500 line chunk needs roughly 16k-24k tokens.
ollama.num_ctx = 0

# Function: Thinking mode for models that support it, for example Qwen3. Better prioritization, deduplication and
# format adherence, but 3-5x slower, and the thinking shares the output budget and context window with the answer.
# Syntax: true (default) uses thinking; models without thinking support are detected and run without it.
# false skips the thinking phase. Empty keeps the model default. CLI alternative: --think / --no-think
ollama.think = true

# Function: How long Ollama keeps the model loaded after the last call.
# Syntax: empty keeps the server default; duration such as 5m or 1h; 0 unloads right after the run (useful for cron); -1 keeps it loaded.
ollama.keep_alive = ""

# Log input

# Function: Number of log lines per AI request.
# Syntax: integer line count. 500 is recommended for 64k context-size thinking models.
logs.chunk_size = 500

# Function: Maximum number of chunks analyzed in parallel.
# Syntax: positive integer. Default 1 preserves fully sequential API calls. CLI alternative: --max-parallel N
logs.max_parallel = 1

# Function: Maximum number of filtered log lines to analyze. Prevents accidental huge/costly API runs.
# Syntax: positive integer. Use --max-lines NUMBER to override for one run.
logs.max_lines = 15000

# Function: Maximum size of the combined chunk findings sent to the final report request, in characters.
# Syntax: positive integer, or 0 to disable. Aborts before the final API call instead of risking a silently truncated report.
# Roughly 4 characters per token: 120000 characters fit comfortably into a 64k context together with an 8192 token answer.
# CLI alternative: --max-final-input-chars N
logs.max_final_input_chars = 120000

# Function: For stdin/file input, analyze only the last N filtered lines.
# Syntax: integer. 0 means no tail limit. CLI alternative: --tail-lines N
logs.tail_lines = 0

# Function: Exclude log lines containing these simple keywords before they are sent to the AI.
# Syntax: empty, comma-separated keywords, repeated key, or multi-line heredoc. Matching is case-insensitive substring matching.
# Example: harmless noisy message, known flaky health check
logs.exclude_patterns = ""

# Function: Exclude log lines matching these regular expressions before they are sent to the AI.
# Syntax: empty, comma-separated Python regex list, repeated key, or multi-line heredoc. Use heredoc for regexes containing commas.
# Example: ^.*known-noisy-service.*retry.*$
logs.exclude_regex_patterns = ""

# Function: Ask the AI to gently ignore these topic areas unless they are severe security, data-loss, hardware, or service-availability events.
# Syntax: empty, comma-separated topics, or multi-line heredoc. This is semantic AI guidance, not a hard filter.
# Example: cosmetic UI warnings, known lab test messages
logs.gently_ignore = ""

# Function: Ask the AI to completely ignore these topic areas in the report.
# Syntax: empty, comma-separated topics, or multi-line heredoc. This is strict semantic AI guidance, not a line filter.
# Example: desktop notifications, printer discovery noise
logs.ignore = ""

# Function: Ask the AI to analyze only a specific focus area. Non-matching findings are omitted.
# Syntax: empty or short plain text.
# Example: security incidents and network problems
logs.focus_on = ""

# E-mail report

# Function: Default recipient for --mail without an address.
# Syntax: empty string or email address.
mail.default_to = ""

# Function: Sender address for report emails.
# Syntax: email address.
mail.from = ai-log-analyzer@localhost

# Function: Subject line for report emails.
# Syntax: plain text.
mail.subject = Linux log AI report

# Function: SMTP server hostname or IP address.
# Syntax: hostname or IP, for example smtp.example.com, mail.company.tld, or 127.0.0.1
mail.smtp_server = localhost

# Function: SMTP server port.
# Syntax: integer port, usually 25, 465, or 587.
mail.smtp_port = 25

# Function: SMTP username. Empty means no SMTP authentication.
# Syntax: string.
mail.smtp_username = ""

# Function: SMTP password. Empty means no SMTP authentication.
# Syntax: string.
mail.smtp_password = ""

# Function: Use implicit TLS from connection start, usually port 465.
# Syntax: true or false.
mail.use_tls = false

# Function: Use STARTTLS after connecting, usually port 587.
# Syntax: true or false.
mail.use_starttls = false

# Advanced Parameters

# Function: Sampling temperature (both backends). Lower values usually improve deterministic formatting.
# Syntax: decimal number, for example 0, 0.1, 0.2.
ai.temperature = 0.1

# Function: HTTP timeout for one API attempt (both backends).
# Syntax: integer seconds.
ai.timeout_seconds = 120

# Function: Number of retries after the initial API attempt (both backends).
# Syntax: integer. Default 1 means: one initial attempt plus one retry. Consider 3 when logs.max_parallel > 1 against rate-limited cloud APIs.
ai.max_retries = 1

# Function: Base delay between retries (both backends). Attempt number is multiplied by this value.
# Syntax: seconds as integer or decimal, for example 2 or 5.0. A Retry-After header sent by the API takes precedence (capped at 60 seconds).
ai.retry_backoff_seconds = 2

# Function: API endpoint path appended to openai.api_url.
# Syntax: /v1/chat/completions recommended. Leave it at this default and the path follows openai.api_style
# automatically (/v1/responses for responses). Set it explicitly only for unusual proxies.
openai.api_path = /v1/chat/completions

# Function: Request payload style for the openai backend.
# Syntax: chat_completions recommended for OpenAI, LiteLLM and Ollama's OpenAI-compatible endpoint. responses is available for advanced use.
openai.api_style = chat_completions

# Function: Name of the max-token field for chat_completions payloads.
# Syntax: max_tokens for most OpenAI-compatible APIs; max_completion_tokens for selected newer APIs.
openai.max_tokens_field = max_tokens

# Function: Extra HTTP headers sent to the openai backend.
# Syntax: JSON object, for example {"X-Header":"value"}. Use {} for none.
openai.extra_headers = {}

# Function: API endpoint path appended to ollama.api_url.
# Syntax: /api/chat unless a proxy in front of Ollama uses a different prefix.
ollama.api_path = /api/chat

# Function: Default output mode.
# Syntax: report, errors, or all. report prints only the final report and is best for normal use.
defaults.mode = report

# Function: Show progress bar while chunks are analyzed.
# Syntax: true or false.
defaults.progress = true

# Function: Print filtered input lines before AI analysis.
# Syntax: true or false.
defaults.print_input = false

# Function: Optional directory for saving chunk results and final report as text files.
# Syntax: empty string or directory path.
defaults.save_dir = ""

# Function: Suppress the data privacy and cost warning before the first API call.
# Syntax: true or false. CLI alternative: --no-warn
safety.no_warn = false

# Function: Include example timestamps in chunk results and final report.
# Syntax: true or false. Default true for easier later log searches.
timestamps.enabled = true

# Function: Number of example timestamps requested per error.
# Syntax: positive integer.
timestamps.samples_per_error = 3

# Function: System prompt used for per-chunk error analysis.
# Syntax: multi-line text.
prompts.chunk_system <<EOF
You are a senior Linux/SRE log analyst.
Analyze the provided log lines and identify only actionable operational problems.
The input may come from stdin, one or more log files, Docker logs, Kubernetes logs, syslog, application logs, or another user-provided command.
Some lines may include severity labels such as [err], [warning], [notice], or [info]. Use those labels when available, but do not assume they are present.

Return exactly "ok" if there are no events that require near-term action, including when the chunk contains only harmless warnings.
Otherwise quote only log entries that need attention, including:
- configuration errors
- failed services
- service errors
- security incidents
- storage, hardware, network, or kernel events that require action

Deduplicate repeated events and prefer the most representative log line.
Ignore harmless noise, expected transient warnings, and any already-filtered patterns.
Treat [info] and [notice] as lower priority unless they are repeated, security-relevant, or clearly connected to a focused issue.
Use ASCII only.
Use exactly this format:

* Error: <log entry>
* Examples: <timestamp 1> (first seen), <timestamp 2>, ... <timestamp N> (last seen)
* Search: <grep command to find this finding again>
* Explanation: <explain the error, likely impact, and what to check next>
EOF

# Function: Optional operator text placed before the log data block in the user message.
# Syntax: empty, plain, or multi-line text. Keep instructions in prompts.chunk_system; the log data itself is wrapped in
# BEGIN/END LOG DATA markers and the model is told to treat everything inside as untrusted data.
prompts.chunk_user_prefix = ""

# Function: System prompt used for the final report.
# Syntax: multi-line text.
prompts.final_system <<EOF
You are a senior Linux/SRE incident analyst.
Create a concise operational report from the chunk analyses.

Rules:
- Use only events mentioned in the chunk analyses.
- Do not invent errors.
- Deduplicate repeated findings.
- Prioritize recommendations by urgency.
- Use ASCII only.

Use this structure:

Summary
-------
<short summary>

Priority 1 - Fix soon
---------------------
<actionable items, impact, search command, recommended commands/checks>

Priority 2 - Investigate
------------------------
<important but less urgent items, including search commands>

Priority 3 - Monitor
--------------------
<items to watch, including search commands>

Likely chain of events
----------------------
<only include if a plausible chain can be inferred from multiple findings; otherwise omit this section>

Recommended immediate checks
----------------------------
<commands and checks admins should run next>

Notes
-----
<uncertainties or missing context>
EOF

# Function: User prompt template for the final report. {chunk_results} is replaced automatically.
# Syntax: multi-line text containing {chunk_results}.
prompts.final_user_template <<EOF
Create a report with prioritized recommendations from the following AI chunk analyses.

{chunk_results}
EOF
